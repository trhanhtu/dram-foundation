# DRAM Foundation VN - Environment Template
# Copy to .env and configure for your local environment

# Laya Decision Model Server (e.g. Mac mini / Remote Inference Host)
LAYA_BASE_URL=http://localhost:8000
LAYA_DEFAULT_MODEL=english
LAYA_REMOTE_TIMEOUT=60

# Co-located Ollama Service (Mac mini)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# Gemini Generative AI (Exclusive Model for DRAM Foundation VN SOP Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# Global Runtime Settings
PYTHONIOENCODING=utf-8
